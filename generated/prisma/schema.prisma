// schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ============================================================
 * NEXTAUTH MODELS
 * (Standardized for Auth.js v5)
 * ============================================================
 */

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/**
 * ============================================================
 * USER MODEL
 * (The bridge between Auth and Business Logic)
 * ============================================================
 */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          String    @default("user")
  createDate    DateTime  @default(now()) @map("create_date")

  // Auth Relations
  accounts Account[]
  sessions Session[]

  // Business Relations
  posts     Post[]
  requests  RequestInfo[]
  instances InstanceInfo[]
  editLogs  RequestEditLog[]

  @@map("users")
}

/**
 * ============================================================
 * POST MODEL
 * ============================================================
 */

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  @@index([name])
  @@map("posts")
}

/**
 * ============================================================
 * BUSINESS MODELS
 * (Refactored: BigInt -> Int, snake_case -> camelCase)
 * ============================================================
 */

model RequestInfo {
  // Switched to Int to prevent Next.js client crashes
  requestId     Int      @id @default(autoincrement()) @map("request_id")
  userId        String   @map("user_id")
  templateId    Int      @map("template_id")
  instantName   String   @map("instant_name")
  requestStatus String   @map("request_status")
  requestDate   DateTime @map("request_datetime")
  endDate       DateTime @map("end_datetime")
  lastEditDate  DateTime @map("last_edit_datetime")
  note          String
  isApprove     Boolean  @map("is_approve")

  // Relations
  user          User               @relation(fields: [userId], references: [id])
  template      InstanceOsTemplate @relation(fields: [templateId], references: [templateId]) // Points to the Combo
  notifications NotificationInfo[]
  editLogs      RequestEditLog[]
  instances     InstanceInfo[]

  @@index([userId])
  @@index([templateId])
  @@map("request_info")
}

model RequestEditLog {
  logNo     Int      @id @default(autoincrement()) @map("log_no")
  userId    String   @map("user_id")
  requestId Int      @map("request_id")
  jsonData  Json     @map("json") // Changed String -> Json
  timestamp DateTime

  user    User        @relation(fields: [userId], references: [id])
  request RequestInfo @relation(fields: [requestId], references: [requestId])

  @@index([userId])
  @@index([requestId])
  @@map("request_edit_log")
}

model InstanceTemplate {
  instanceId    Int    @id @default(autoincrement()) @map("instance_id")
  name          String
  cpuAmount     Int    @map("cpu_amount")
  ramAmount     Int    @map("ram_amount")
  gpuAmount     Int    @map("gpu_amount")
  storageAmount Int    @map("storage_amount")

  osTemplates InstanceOsTemplate[]

  @@map("instance_template")
}

model OsTemplate {
  osId              Int    @id @default(autoincrement()) @map("os_id")
  osName            String @map("os_name")
  imageLocation     String @map("image_location")
  supportedPlatform String @map("supported_platform")

  instancesOs InstanceOsTemplate[]

  @@map("os_template")
}

model InstanceOsTemplate {
  templateId Int @id @default(autoincrement()) @map("template_id")
  osId       Int @map("os_id")
  instanceId Int @map("instance_id")

  osTemplate OsTemplate       @relation(fields: [osId], references: [osId])
  instance   InstanceTemplate @relation(fields: [instanceId], references: [instanceId])
  requests   RequestInfo[]

  @@index([osId])
  @@index([instanceId])
  @@map("instance_os_template")
}

model InstanceInfo {
  instanceId   Int      @id @default(autoincrement()) @map("instance_id")
  userId       String   @map("user_id")
  requestId    Int      @map("request_id")
  username     String
  password     String
  machineState String   @map("machine_state")
  ipAddr       String   @map("ip_addr")
  createDate   DateTime @map("create_date")
  expireDate   DateTime @map("expire_date")

  // FIX: This must be String to hold a User ID (CUID)
  updateBy   String   @map("update_by")
  updateDate DateTime @map("update_date")

  user    User        @relation(fields: [userId], references: [id])
  request RequestInfo @relation(fields: [requestId], references: [requestId])

  @@index([userId])
  @@index([requestId])
  @@map("instance_info")
}

model NotificationInfo {
  notificationId Int      @id @default(autoincrement()) @map("notification_id")
  requestId      Int      @map("request_id")
  sendDate       DateTime @map("send_date")
  isSend         Boolean  @map("is_send")
  messageSubject String   @map("message_subject")
  message        String

  request RequestInfo @relation(fields: [requestId], references: [requestId])

  @@index([requestId])
  @@map("notification_info")
}
