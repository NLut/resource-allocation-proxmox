// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

model UserInfo {
  user_id     BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(100)
  id          String   @db.VarChar(11)
  is_admin    Boolean
  is_user     Boolean
  username    String   @db.VarChar(50)
  password    Bytes
  gauth_token Json

  // Relations
  requests         RequestInfo[]
  requestEditLogs  RequestEditLog[]
  instances        InstanceInfo[]

  @@map("user_info")
}

model RequestEditLog {
  log_no     BigInt   @id @default(autoincrement())
  user_id    BigInt
  request_id BigInt
  json       String   @db.VarChar(1000)
  timestamp  DateTime

  // Relations
  user    UserInfo    @relation(fields: [user_id], references: [user_id])
  request RequestInfo @relation(fields: [request_id], references: [request_id])

  @@map("request_edit_log")
}

model RequestInfo {
  request_id         BigInt   @id @default(autoincrement())
  user_id            BigInt
  template_id        BigInt
  instant_name       String   @db.VarChar(100)
  request_status     String   @db.VarChar(20)
  request_datetime   DateTime
  end_datetime       DateTime
  last_edit_datetime DateTime
  note               String   @db.VarChar(1000)

  // Relations
  user         UserInfo           @relation(fields: [user_id], references: [user_id])
  template     InstanceOsTemplate @relation(fields: [template_id], references: [template_id])
  notifications NotificationInfo[]
  editLogs     RequestEditLog[]
  instances    InstanceInfo[]

  @@map("request_info")
}

model NotificationInfo {
  notification_id BigInt  @id @default(autoincrement())
  request_id      BigInt
  send_date       DateTime @db.Date
  is_send         Boolean
  text            String  @db.VarChar(1000)

  // Relations
  request RequestInfo @relation(fields: [request_id], references: [request_id])

  @@map("notification_info")
}

model OsTemplate {
  os_id              BigInt  @id @default(autoincrement())
  image_location     String  @db.VarChar(100)
  supported_platform String  @db.VarChar(50)

  // Relations
  instanceOsTemplates InstanceOsTemplate[]

  @@map("os_template")
}

model InstanceTemplate {
  instance_id    BigInt  @id @default(autoincrement())
  name           String  @db.VarChar(50)
  cpu_amount     Int
  ram_amount     Int
  gpu_amount     Int
  storage_amount Int

  // Relations
  instanceOsTemplates InstanceOsTemplate[]

  @@map("instance_template")
}

model InstanceOsTemplate {
  template_id BigInt @id @default(autoincrement())
  os_id       BigInt
  instance_id BigInt

  // Relations
  osTemplate       OsTemplate       @relation(fields: [os_id], references: [os_id])
  instanceTemplate InstanceTemplate @relation(fields: [instance_id], references: [instance_id])
  requests         RequestInfo[]

  @@map("instance_os_template")
}

model InstanceInfo {
  instance_id   BigInt  @id @default(autoincrement())
  user_id       BigInt
  request_id    BigInt
  username      String  @db.VarChar(50)
  password      String  @db.VarChar(50)
  machine_state String  @db.VarChar(50)
  ip_addr       String  @db.Inet

  // Relations
  user    UserInfo    @relation(fields: [user_id], references: [user_id])
  request RequestInfo @relation(fields: [request_id], references: [request_id])

  @@map("instance_info")
}
